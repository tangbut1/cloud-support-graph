# ==== 应用基础配置 ====
APP_NAME=cloud-support-graph
APP_ENV=development
APP_DB_PATH=../data/app.db
CHECKPOINT_DB_PATH=../data/checkpoints.db

# ==== JWT 安全配置（生产环境务必替换为强随机字符串，>=32 字节）====
# 可通过 `openssl rand -hex 32` 生成，严禁在生产环境沿用占位值
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 默认关闭免密演示登录；仅本地开发/内网答辩演示可临时改为 true，公网生产环境必须保持 false
ENABLE_DEMO_LOGIN=false
# 生产环境（APP_ENV=production）执行 seed 初始化账号时必须提供 >=10 位强口令（禁止沿用 Passw0rd!）
# 本地开发环境留空则自动使用默认开发口令
SEED_DEFAULT_PASSWORD=

# ==== 大模型 API 配置 ====
# 本项目实测可用：OpenCode Go 套餐（OpenCode Zen）
#   注意：Go 套餐必须走 /inference/go/v1 入口；走 /zen/v1 会返回 402（那是按量付费通道）
#   请求需要 x-opencode-session 头，代码已自动注入稳定的会话 ID，无需手填
#   可选 LLM_SESSION_ID 固定该 ID（留空则按进程自动生成）
LLM_BASE_URL=https://opencode.ai/inference/go/v1
LLM_MODEL_NAME=deepseek-v4.1-flash
LLM_API_KEY=sk-your-api-key-here
LLM_TIMEOUT_SECONDS=120
LLM_SESSION_ID=

# ==== 知识检索与拒答阈值（标定实验结果见 docs/MEASUREMENTS_LOG.md）====
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
MAX_TOOL_STEPS=4

# ==== 可选：Langfuse 远程链路观测（默认关闭，本地 agent_traces 表始终生效）====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
